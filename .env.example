# ==========================================================
# AptiVerse Environment Configuration Example
# Copy this file to .env.local or .env for local development
# NEVER commit real secret keys or production tokens to git!
# ==========================================================

# CMAT Current Affairs External API Key (Optional)
# If left blank or invalid, AptiVerse seamlessly uses the verified local CMAT content bank fallback
CMAT_CURRENT_AFFAIRS_API_KEY=

# Application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000
